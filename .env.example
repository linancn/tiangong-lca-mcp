# Remote MCP OAuth 2.1 broker (the only supported remote auth mode)
MCP_AUTH_MODE=broker
MCP_PUBLIC_ORIGIN=http://localhost:9278
MCP_OAUTH_HOST_CLIENTS_JSON=[{"client_id":"tiangong-mcp-inspector-dev","client_name":"MCP Inspector Dev","redirect_uris":["http://127.0.0.1:6276/oauth/callback"],"scope":"mcp:tools"}]
MCP_OAUTH_SESSION_ENCRYPTION_KEY=Generate32RandomBytesAndEncodeAsBase64url
MCP_OAUTH_ACCESS_TTL_SECONDS=600
MCP_OAUTH_REFRESH_TTL_SECONDS=2592000

# Supabase OAuth broker client (confidential, fixed registration)
SUPABASE_BASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_OAUTH_CLIENT_ID=your-confidential-oauth-client-id
SUPABASE_OAUTH_CLIENT_SECRET=your-confidential-oauth-client-secret
SUPABASE_OAUTH_REDIRECT_URI=http://localhost:9278/oauth/callback

# Shared Edge/MCP Upstash instance. These REST names intentionally differ from
# Portal's retained UPSTASH_REDIS_URL / UPSTASH_REDIS_TOKEN pair.
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# GLAD API configuration
GLAD_API_KEY=your-glad-api-key
GLAD_API_BASE_URL=https://www.globallcadataaccess.org/api/v1

# Server configuration
PORT=9278
HOST=0.0.0.0
NODE_OPTIONS=--max-old-space-size=384
