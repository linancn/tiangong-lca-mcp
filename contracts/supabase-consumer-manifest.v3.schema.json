{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/linancn/tiangong-lca-mcp/contracts/supabase-consumer-manifest.v3.schema.json",
  "title": "TianGong MCP Supabase consumer candidate manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "repository",
    "sourceTreeCommit",
    "deliveryHead",
    "authority",
    "source",
    "capabilities",
    "occurrences",
    "counts",
    "publicResidue",
    "pending",
    "absenceProofs"
  ],
  "properties": {
    "schema": {
      "const": "tiangong.supabase-consumer-manifest.v3"
    },
    "version": {
      "const": 3
    },
    "repository": {
      "const": "linancn/tiangong-lca-mcp"
    },
    "sourceTreeCommit": {
      "$ref": "#/$defs/sha"
    },
    "deliveryHead": {
      "$ref": "#/$defs/sha"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "authorizesDatabaseFreeze",
        "authorizesDatabaseMigration",
        "authorizesHostedMutation",
        "authorizesMergeOrDeploy"
      ],
      "properties": {
        "status": {
          "const": "candidate"
        },
        "authorizesDatabaseFreeze": {
          "const": false
        },
        "authorizesDatabaseMigration": {
          "const": false
        },
        "authorizesHostedMutation": {
          "const": false
        },
        "authorizesMergeOrDeploy": {
          "const": false
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "derivation",
        "governedPatterns",
        "exactExemptions",
        "treeDigestAlgorithm",
        "treeDigest",
        "fileCount"
      ],
      "properties": {
        "derivation": {
          "const": "typescript-compiler-ast-and-json-parser-v1"
        },
        "governedPatterns": {
          "const": [
            "src/**/*.{ts,tsx,js,mjs,cjs}",
            "scripts/**/*.{ts,tsx,js,mjs,cjs}",
            "package.json"
          ]
        },
        "exactExemptions": {
          "const": [
            "scripts/ci/scan-data-api-consumers.ts"
          ]
        },
        "treeDigestAlgorithm": {
          "const": "sha256(mode\\0path\\0blobOid\\0)"
        },
        "treeDigest": {
          "$ref": "#/$defs/sha256"
        },
        "fileCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "occurrences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/occurrence"
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "occurrences",
        "capabilities",
        "tools",
        "transports",
        "credentials",
        "schemas"
      ],
      "properties": {
        "occurrences": {
          "type": "integer",
          "minimum": 1
        },
        "capabilities": {
          "type": "integer",
          "minimum": 1
        },
        "tools": {
          "type": "integer",
          "minimum": 1
        },
        "transports": {
          "$ref": "#/$defs/countMap"
        },
        "credentials": {
          "$ref": "#/$defs/countMap"
        },
        "schemas": {
          "$ref": "#/$defs/countMap"
        }
      }
    },
    "publicResidue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relations",
        "rpcs",
        "views"
      ],
      "properties": {
        "relations": {
          "$ref": "#/$defs/stringSet"
        },
        "rpcs": {
          "$ref": "#/$defs/stringSet"
        },
        "views": {
          "$ref": "#/$defs/stringSet"
        }
      }
    },
    "pending": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/pending"
      }
    },
    "absenceProofs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/absence"
      }
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "countMap": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name",
        "registrationFile",
        "runtimeTransports"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(mcp-tool|transport):"
        },
        "kind": {
          "enum": [
            "mcp-tool",
            "transport-auth"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "registrationFile": {
          "type": "string",
          "pattern": "^src/"
        },
        "runtimeTransports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "stdio",
              "streamable-http"
            ]
          }
        }
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startOffset",
        "endOffset",
        "startLine",
        "startColumn",
        "endLine",
        "endColumn",
        "sha256"
      ],
      "properties": {
        "startOffset": {
          "type": "integer",
          "minimum": 0
        },
        "endOffset": {
          "type": "integer",
          "minimum": 1
        },
        "startLine": {
          "type": "integer",
          "minimum": 1
        },
        "startColumn": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "endColumn": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "file",
        "line",
        "span",
        "capability",
        "operation",
        "transport",
        "credential",
        "schema",
        "object",
        "signature",
        "acl",
        "semantics",
        "upstream",
        "sourceClass"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^mcp-[0-9a-f]{24}$"
        },
        "file": {
          "type": "string",
          "pattern": "^(src|scripts)/"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "span": {
          "$ref": "#/$defs/span"
        },
        "capability": {
          "type": "string",
          "pattern": "^(mcp-tool|transport):"
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "transport": {
          "enum": [
            "postgrest",
            "edge-function-http",
            "auth",
            "storage",
            "realtime",
            "direct-postgres",
            "subprocess-cli"
          ]
        },
        "credential": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "object": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "string",
          "minLength": 1
        },
        "acl": {
          "type": "string",
          "minLength": 1
        },
        "semantics": {
          "type": "string",
          "minLength": 1
        },
        "upstream": {
          "$ref": "#/$defs/stringSet"
        },
        "sourceClass": {
          "enum": [
            "typescript-ast",
            "javascript-ast",
            "json-parser"
          ]
        }
      }
    },
    "pending": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "reason",
        "upstream"
      ],
      "properties": {
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "upstream": {
          "$ref": "#/$defs/stringSet"
        }
      }
    },
    "absence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "result",
        "evidence"
      ],
      "properties": {
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "const": "absent"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
